<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ZeroCue.DataProbe.ViewModels"
        xmlns:views="clr-namespace:ZeroCue.DataProbe.Views"
        xmlns:controls="using:ZeroCue.DataProbe.Controls"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="ZeroCue.DataProbe.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="ZeroCue - SCUF Envision Pro"
        Width="1180" Height="820"
        MinWidth="1440" MinHeight="900"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/zerocue.ico"
        Background="{DynamicResource AppBackgroundColor}">

    <Window.Styles>
        <Style Selector="RadioButton.navBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryColor}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="20,15" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />

            <Setter Property="HorizontalContentAlignment" Value="Left" />

            <Setter Property="CornerRadius" Value="8" />

            <Setter Property="Margin" Value="10,5" />

            <Setter Property="Template">

                <ControlTemplate>

                    <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">

                        <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />

                    </Border>

                </ControlTemplate>

            </Setter>

        </Style>

        <Style Selector="RadioButton.navBtn:pointerover">

            <Setter Property="Background" Value="{DynamicResource PanelBackgroundColor}" />

            <Setter Property="Foreground" Value="#EAF2FF" />

        </Style>

        <Style Selector="RadioButton.navBtn:checked">
            <Setter Property="Background" Value="{DynamicResource BorderColor}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}" />
        </Style>

        <Style Selector="RadioButton.tabBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryColor}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="30,12" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="BorderBrush" Value="#273044" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.tabBtn:pointerover">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundColor}" />
            <Setter Property="BorderBrush" Value="#3D4A66" />
            <Setter Property="Foreground" Value="#EAF2FF" />
        </Style>
        <Style Selector="RadioButton.tabBtn:checked">
            <Setter Property="Background" Value="{DynamicResource ToggleContainerColor}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}" />
        </Style>

        <Style Selector="RadioButton.mappingModeBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryColor}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="MinWidth" Value="124" />
            <Setter Property="Height" Value="38" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="RadioButton.mappingModeBtn:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentHoverColor}" />
            <Setter Property="Foreground" Value="{DynamicResource TextHeaderColor}" />
        </Style>

        <Style Selector="RadioButton.mappingModeBtn:checked">
            <Setter Property="Background" Value="{DynamicResource ToggleCapsuleColor}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}" />
        </Style>

        <Style Selector="Border.mappingModeBar">
            <Setter Property="Background" Value="{DynamicResource AppBackgroundColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="24,14" />
        </Style>

        <Style Selector="Border.segmentShell">
            <Setter Property="Background" Value="{DynamicResource ToggleContainerColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="3" />
        </Style>

        <Style Selector="Button.layerSegment">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryColor}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinWidth" Value="118" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Button.layerSegment.active">
            <Setter Property="Background" Value="{DynamicResource ToggleCapsuleColor}" />
            <Setter Property="Foreground" Value="{DynamicResource TextHeaderColor}" />
        </Style>

        <Style Selector="Button.layerSegment:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentHoverColor}" />
            <Setter Property="Foreground" Value="{DynamicResource TextHeaderColor}" />
        </Style>

        <Style Selector="Border.shiftBindingPill">
            <Setter Property="Background" Value="{DynamicResource AltPanelBackgroundColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderHighlightColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Height" Value="44" />
        </Style>

        <Style Selector="Border.shiftBindingIcon">
            <Setter Property="Background" Value="{DynamicResource HeaderBackgroundColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderHighlightColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
        </Style>

        <Style Selector="Button.editShiftButton">
            <Setter Property="Background" Value="{DynamicResource AccentHoverColor}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderHighlightColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="MinWidth" Value="82" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Button.editShiftButton:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}" />
        </Style>

        <!-- Spinner Animation -->
        <Style Selector="Arc.spinner">
            <Setter Property="RenderTransform">
                <RotateTransform />
            </Setter>
            <Style.Animations>
                <Animation Duration="0:0:1" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Window.Styles>

    <Panel>
        <Grid ColumnDefinitions="260,*">

            <!-- Left Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- App Logo / Title -->
                    <StackPanel Grid.Row="0" Margin="24,14,24,32" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        <Image Source="avares://ZeroCue.DataProbe/Assets/zerocue_logo_white.png" Stretch="Uniform" Height="58" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ZeroCue" FontSize="27" FontWeight="Black" Foreground="White" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Navigation -->
                    <StackPanel Grid.Row="1">
                        <RadioButton Classes="navBtn" GroupName="Nav" IsChecked="True" Command="{Binding SetSectionCommand}" CommandParameter="Mapping">
                            <StackPanel Orientation="Horizontal" Spacing="15">
                                <materialIcons:MaterialIcon Kind="Gamepad" Width="22" Height="22" />
                                <TextBlock Text="{DynamicResource NavMapping}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Classes="navBtn" GroupName="Nav" Command="{Binding SetSectionCommand}" CommandParameter="Profiles">
                            <StackPanel Orientation="Horizontal" Spacing="15">
                                <materialIcons:MaterialIcon Kind="Account" Width="22" Height="22" />
                                <TextBlock Text="{DynamicResource NavProfiles}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Classes="navBtn" GroupName="Nav" Command="{Binding SetSectionCommand}" CommandParameter="Settings">
                            <StackPanel Orientation="Horizontal" Spacing="15">
                                <materialIcons:MaterialIcon Kind="Cog" Width="22" Height="22" />
                                <TextBlock Text="{DynamicResource NavSettings}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- Connection Status -->
                    <Border Grid.Row="2" Margin="18,0,18,22" Padding="14,12" CornerRadius="8" Background="{DynamicResource AltPanelBackgroundColor}" BorderBrush="{DynamicResource BorderHighlightColor}" BorderThickness="1">
                        <Grid ColumnDefinitions="30,*" VerticalAlignment="Center">
                            <Panel Grid.Column="0" Width="30" Height="30" VerticalAlignment="Center">
                                <!-- Waiting -->
                                <Panel IsVisible="{Binding IsStatusWaiting}">
                                    <Ellipse Width="24" Height="24" Stroke="#657084" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Ellipse Width="7" Height="7" Fill="#657084" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Panel>

                                <!-- Connecting -->
                                <Panel IsVisible="{Binding IsStatusConnecting}">
                                    <Arc Classes="spinner" Width="26" Height="26" StartAngle="0" SweepAngle="300" Stroke="{DynamicResource AccentColor}" StrokeThickness="2.5" StrokeLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <materialIcons:MaterialIcon Kind="Gamepad" Width="15" Height="15" Foreground="{DynamicResource AccentColor}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Panel>

                                <!-- Connected -->
                                <Panel IsVisible="{Binding IsStatusConnected}">
                                    <Ellipse Width="26" Height="26" Fill="{DynamicResource ConnectedRingColor}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <materialIcons:MaterialIcon Kind="Gamepad" Width="18" Height="18" Foreground="{DynamicResource ConnectedDotColor}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Border Background="#10141D" BorderBrush="{DynamicResource ConnectedDotColor}" BorderThickness="1" CornerRadius="3" Padding="2,0" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsVisible="{Binding IsStatusUsbConnected}">
                                        <TextBlock Text="USB" Foreground="{DynamicResource ConnectedDotColor}" FontSize="6" FontWeight="Bold" />
                                    </Border>
                                    <Border Background="#10141D" BorderBrush="{DynamicResource ConnectedDotColor}" BorderThickness="1" CornerRadius="3" Padding="2,0" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsVisible="{Binding IsStatusWirelessConnected}">
                                        <TextBlock Text="RF" Foreground="{DynamicResource ConnectedDotColor}" FontSize="6" FontWeight="Bold" />
                                    </Border>
                                </Panel>

                                <!-- Error -->
                                <Panel IsVisible="{Binding IsStatusError}">
                                    <Ellipse Width="26" Height="26" Fill="#33D13438" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <materialIcons:MaterialIcon Kind="AlertCircle" Width="18" Height="18" Foreground="{DynamicResource ErrorColor}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Panel>
                            </Panel>

                            <StackPanel Grid.Column="1" MinWidth="0" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusText}"
                                           Foreground="#EAF2FF"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           TextTrimming="None" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <Carousel Grid.Column="1" Background="{DynamicResource AppBackgroundColor}" SelectedIndex="{Binding SelectedSectionIndex}">
                <Carousel.PageTransition>
                    <CrossFade Duration="0:0:0.25" />
                </Carousel.PageTransition>

            <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource AppBackgroundColor}">

                <!-- Section Header (Mapping) -->
                <Border Grid.Row="0" Background="{DynamicResource PanelBackgroundColor}" Padding="30,18" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" ZIndex="10">

                    <Grid VerticalAlignment="Center">

                        <!-- Profiles Combobox (Moved to sidebar) -->

                        <!-- Tabs -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Spacing="15" ZIndex="2">
                            <RadioButton Classes="tabBtn" Content="{DynamicResource TabMapping}" GroupName="Tabs" IsChecked="True" Command="{Binding SetTabCommand}" CommandParameter="Mapping" />
                            <RadioButton Classes="tabBtn" Content="{DynamicResource TabTriggers}" GroupName="Tabs" Command="{Binding SetTabCommand}" CommandParameter="Triggers" />
                            <RadioButton Classes="tabBtn" Content="{DynamicResource TabSticks}" GroupName="Tabs" Command="{Binding SetTabCommand}" CommandParameter="Sticks" />
                        </StackPanel>
                    </Grid>

                </Border>



                <!-- Body Content -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" MinWidth="300" MaxWidth="360" />
                        <ColumnDefinition Width="75*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Sidebar: Device Parameters (POC) -->
                    <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,1,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="22,20" Spacing="18">
                            <!-- Perfil -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="{DynamicResource ActiveProfile}" Foreground="White" FontSize="17" FontWeight="Bold" />
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" Width="192" Background="{DynamicResource PanelBackgroundColor}" Foreground="White" CornerRadius="6" BorderThickness="0" Padding="12,8" />
                                    <Button Content="{DynamicResource New}" Command="{Binding CreateProfileCommand}" Background="{DynamicResource BorderColor}" Foreground="White" Padding="10,8" CornerRadius="6" />
                                </StackPanel>
                            </StackPanel>

                            <Border Height="1" Background="{DynamicResource BorderColor}" Margin="0,2" />

                            <TextBlock Text="{DynamicResource ControllerSettings}" Foreground="White" FontSize="17" FontWeight="Bold" />

                            <!-- Battery UI hidden until real battery telemetry is implemented.
                            <StackPanel Spacing="8">
                                <TextBlock Text="{DynamicResource Battery}" Foreground="{DynamicResource TextSecondaryColor}" FontSize="14" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="Battery80" Width="22" Height="22" Foreground="{DynamicResource RgbGreenColor}" />
                                    <TextBlock Text="{DynamicResource BatteryInUse}" Foreground="White" FontSize="15" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>

                            <Border Height="1" Background="{DynamicResource BorderColor}" Margin="0,2" />
                            -->

                            <!-- Eco Mode -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="{DynamicResource PowerMode}" Foreground="{DynamicResource TextSecondaryColor}" FontSize="14" FontWeight="SemiBold" />
                                <ToggleSwitch IsChecked="{Binding IsEcoModeEnabled}" OnContent="{DynamicResource EcoModeOn}" OffContent="{DynamicResource EcoModeOff}" Foreground="White" FontSize="13" />
                            </StackPanel>

                            <Border Height="1" Background="{DynamicResource BorderColor}" Margin="0,2" />

                            <!-- Iluminacion (Real) -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="{DynamicResource RgbLighting}" Foreground="{DynamicResource TextSecondaryColor}" FontSize="14" FontWeight="SemiBold" />

                                <Grid ColumnDefinitions="26,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="0,2,0,0">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="R" Foreground="{DynamicResource RgbRedColor}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Width="22" />
                                    <Slider Grid.Row="0" Grid.Column="1" Value="{Binding RgbRed}" Minimum="0" Maximum="255" Foreground="{DynamicResource RgbRedColor}" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="G" Foreground="{DynamicResource RgbGreenColor}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Width="22" />
                                    <Slider Grid.Row="1" Grid.Column="1" Value="{Binding RgbGreen}" Minimum="0" Maximum="255" Foreground="{DynamicResource RgbGreenColor}" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="B" Foreground="{DynamicResource RgbBlueColor}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Width="22" />
                                    <Slider Grid.Row="2" Grid.Column="1" Value="{Binding RgbBlue}" Minimum="0" Maximum="255" Foreground="{DynamicResource RgbBlueColor}" />

                                    <materialIcons:MaterialIcon Grid.Row="3" Grid.Column="0" Kind="Brightness6" Width="18" Height="18" Foreground="{DynamicResource TextSecondaryColor}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                    <Slider Grid.Row="3" Grid.Column="1" Value="{Binding RgbBrightness}" Minimum="0" Maximum="1000" VerticalAlignment="Center" Foreground="{DynamicResource AccentColor}" />

                                    <!-- Barra de luz simulada -->
                                    <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Height="6" CornerRadius="3" Background="{Binding CurrentColorHex}" HorizontalAlignment="Stretch" Margin="0,10,0,4" />
                                </Grid>
                            </StackPanel>

                            <Border Height="1" Background="{DynamicResource BorderColor}" Margin="0,2" />

                            <!-- Rumble -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="{DynamicResource Vibration}" Foreground="{DynamicResource TextSecondaryColor}" FontSize="14" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{DynamicResource Intensity}" Foreground="{DynamicResource TextSecondaryColor}" FontSize="12" VerticalAlignment="Center" Width="65" />
                                    <Slider Value="{Binding RumbleIntensity, Mode=TwoWay}" Minimum="0" Maximum="100" Width="130" VerticalAlignment="Center" Foreground="{DynamicResource AccentColor}" />
                                    <TextBlock Text="{Binding RumbleIntensityText}" Foreground="White" FontSize="12" VerticalAlignment="Center" Width="34" />
                                </StackPanel>
                                <Button Content="{DynamicResource TestRumble}" Command="{Binding TestRumbleCommand}" Background="{DynamicResource BorderColor}" Foreground="White" Padding="12,8" CornerRadius="6" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Left" />
                            </StackPanel>

                        </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Right Side: Mappings -->
                    <ScrollViewer Grid.Column="1"
                                  Background="{DynamicResource AppBackgroundColor}"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Disabled">
                    <Panel Background="{DynamicResource AppBackgroundColor}">
                        <Panel IsVisible="{Binding IsMappingTabSelected}">
                            <Grid RowDefinitions="Auto,*">
                                <Border Grid.Row="0" Classes="mappingModeBar">
                                    <Grid ColumnDefinitions="*,Auto" MinHeight="44">
                                        <WrapPanel Grid.Column="0"
                                                   Orientation="Horizontal"
                                                   IsVisible="{Binding IsMappingModeAdvanced}"
                                                   VerticalAlignment="Center">
                                            <Border Classes="segmentShell" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <Grid ColumnDefinitions="Auto,Auto">
                                                    <Button Grid.Column="0" Classes="layerSegment" Classes.active="{Binding !IsShiftMode}" Command="{Binding SetStandardModeCommand}">
                                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                                            <materialIcons:MaterialIcon Kind="ControllerClassic" Width="18" Height="18"/>
                                                            <TextBlock Text="{DynamicResource Standard}"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Grid.Column="1" Classes="layerSegment" Classes.active="{Binding IsShiftMode}" Command="{Binding SetShiftModeCommand}">
                                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                                            <materialIcons:MaterialIcon Kind="AppleKeyboardShift" Width="18" Height="18"/>
                                                            <TextBlock Text="{DynamicResource Shift}"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </Border>

                                            <Border Classes="shiftBindingPill" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" VerticalAlignment="Center">
                                                    <Border Grid.Column="0" Classes="shiftBindingIcon">
                                                        <materialIcons:MaterialIcon Kind="AppleKeyboardShift" Width="18" Height="18" Foreground="{DynamicResource AccentColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                                        <TextBlock Text="{DynamicResource ShiftButton}" Foreground="{DynamicResource TextHeaderColor}" FontSize="13" FontWeight="Bold"/>
                                                    </StackPanel>

                                                    <Grid Grid.Column="2" Width="62" Height="32" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12,0,0,0">
                                                        <Image Source="{Binding SelectedShiftModifierIcon}" IsVisible="{Binding HasSelectedShiftModifierIcon}" Stretch="Uniform" Width="54" Height="30"/>
                                                        <controls:GenericMappingIcon Text="{Binding SelectedShiftModifierFallbackText}" Width="42" Height="28" CornerRadius="6" IsVisible="{Binding HasSelectedShiftModifierFallback}"/>
                                                        <TextBlock Text="{DynamicResource Unmapped}" Foreground="{DynamicResource TextHeaderColor}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsVisible="{Binding !HasSelectedShiftModifier}"/>
                                                    </Grid>

                                                    <Button Grid.Column="3" Classes="editShiftButton" Command="{Binding OpenShiftModifierPickerCommand}" ToolTip.Tip="{DynamicResource EditShiftButton}" VerticalAlignment="Center" Margin="10,0,0,0">
                                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                            <materialIcons:MaterialIcon Kind="PencilOutline" Width="14" Height="14" Foreground="{DynamicResource AccentColor}"/>
                                                            <TextBlock Text="{DynamicResource Change}"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </WrapPanel>

                                        <Border Grid.Column="1" Classes="segmentShell" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Grid ColumnDefinitions="Auto,Auto">
                                                <RadioButton Grid.Column="0" Classes="mappingModeBtn" GroupName="MappingMode" IsChecked="{Binding IsMappingModeSimple}">
                                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                                        <materialIcons:MaterialIcon Kind="ControllerClassic" Width="17" Height="17"/>
                                                        <TextBlock Text="{DynamicResource Simple}"/>
                                                    </StackPanel>
                                                </RadioButton>
                                                <RadioButton Grid.Column="1" Classes="mappingModeBtn" GroupName="MappingMode" IsChecked="{Binding IsMappingModeAdvanced}">
                                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                                        <materialIcons:MaterialIcon Kind="Tune" Width="17" Height="17"/>
                                                        <TextBlock Text="{DynamicResource Advanced}"/>
                                                    </StackPanel>
                                                </RadioButton>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Carousel Grid.Row="1" Background="{DynamicResource AppBackgroundColor}" SelectedIndex="{Binding MappingModeIndex}">
                                    <Carousel.PageTransition>
                                        <CrossFade Duration="0:0:0.22" />
                                    </Carousel.PageTransition>
                                    <Viewbox Stretch="Uniform" Margin="0" VerticalAlignment="Top">
                                        <views:ControllerVectorView />
                                    </Viewbox>
                                    <Panel>
                                        <views:AdvancedMappingsView />
                                    </Panel>
                                </Carousel>
                            </Grid>
                        </Panel>

                        <Viewbox Stretch="Uniform" Margin="0" VerticalAlignment="Top" IsVisible="{Binding IsTriggersTabSelected}">
                            <views:TriggersView />
                        </Viewbox>

                        <Viewbox Stretch="Uniform" Margin="0" VerticalAlignment="Top" IsVisible="{Binding IsSticksTabSelected}">
                            <views:SticksView />
                        </Viewbox>
                    </Panel>
                    </ScrollViewer>
                </Grid>

                <!-- Footer -->
                <Border Grid.Row="2" Background="{DynamicResource PanelBackgroundColor}" Padding="30,20" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="15" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="{DynamicResource ResetToDefault}" Command="{Binding ResetToDefaultCommand}" Background="Transparent" Foreground="{DynamicResource TextSecondaryColor}" Padding="20,10" CornerRadius="6" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Profiles Section -->
            <views:ProfilesView />

            <!-- Settings Section -->
            <views:SettingsView />

            </Carousel>

        </Grid>



        <!-- Driver Modal Overlay -->
        <Grid Background="#E60F111A" IsVisible="{Binding IsDriverModalOpen}" ZIndex="200">
            <Border Background="{DynamicResource PanelBackgroundColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="40" MaxWidth="500">

                <Grid>
                    <!-- Confirmation State -->
                    <StackPanel Spacing="20" IsVisible="{Binding IsDriverModalConfirmationState}">
                        <TextBlock Text="{Binding DriverModalTitle}" FontSize="24" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="{Binding DriverModalDescription}" FontSize="16" Foreground="{DynamicResource TextSecondaryColor}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="15" HorizontalAlignment="Right" Margin="0,20,0,0">
                            <Button Content="{DynamicResource Cancel}" Command="{Binding CloseDriverModalCommand}"
                                    Background="Transparent" Foreground="{DynamicResource TextSecondaryColor}" Padding="20,10" CornerRadius="6" FontSize="14" FontWeight="SemiBold" />
                            <Button Content="{DynamicResource Accept}" Command="{Binding ConfirmDriverCommand}"
                                    Background="{DynamicResource AccentColor}" Foreground="{DynamicResource AppBackgroundColor}" Padding="30,10" CornerRadius="6" FontSize="14" FontWeight="Bold" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Processing State -->
                    <StackPanel Spacing="20" IsVisible="{Binding IsDriverModalProcessingState}" HorizontalAlignment="Center">
                        <TextBlock Text="{DynamicResource Processing}" FontSize="24" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" />

                        <!-- Simple Spinner using ProgressBar -->
                        <ProgressBar IsIndeterminate="True" Width="200" Height="4" Margin="0,10" Foreground="{DynamicResource AccentColor}" Background="{DynamicResource BorderColor}" />

                        <TextBlock Text="{Binding ProcessingMessage}" FontSize="14" Foreground="{DynamicResource TextSecondaryColor}" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="400" TextAlignment="Center" />
                        <TextBlock Text="{DynamicResource PowerShellProgress}" FontSize="12" Foreground="#6A7486" HorizontalAlignment="Center" Margin="0,10,0,0" />
                    </StackPanel>

                    <!-- Result State -->
                    <StackPanel Spacing="20" IsVisible="{Binding IsDriverModalResultState}">
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                            <!-- Show Green/Red icon depending on result -->
                            <materialIcons:MaterialIcon Kind="CheckCircle" Width="32" Height="32" Foreground="#107C10"
                                      IsVisible="{Binding IsDriverModalResultSuccess}" />
                            <materialIcons:MaterialIcon Kind="AlertCircle" Width="32" Height="32" Foreground="#D13438"
                                      IsVisible="{Binding IsDriverModalResultError}" />

                            <TextBlock Text="{Binding DriverModalTitle}" FontSize="24" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="{Binding DriverModalDescription}" FontSize="16" Foreground="{DynamicResource TextSecondaryColor}" TextWrapping="Wrap" TextAlignment="Center" />

                        <Button Content="{DynamicResource Continue}" Command="{Binding CloseDriverModalCommand}" HorizontalAlignment="Center" Margin="0,20,0,0"
                                Background="{DynamicResource BorderColor}" Foreground="White" Padding="40,10" CornerRadius="6" FontSize="14" FontWeight="Bold" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <!-- Reset Confirmation Overlay -->
        <Grid Background="#E60F111A" IsVisible="{Binding IsResetToDefaultDialogOpen}" ZIndex="210">
            <Button Command="{Binding CancelResetToDefaultCommand}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" CornerRadius="0" BorderThickness="0" Padding="0">
                <Button.Template>
                    <ControlTemplate>
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Border Background="{DynamicResource PanelBackgroundColor}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="34"
                    MaxWidth="520">
                <StackPanel Spacing="18">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <materialIcons:MaterialIcon Kind="AlertCircleOutline" Width="30" Height="30" Foreground="{DynamicResource AccentColor}" VerticalAlignment="Top"/>
                        <StackPanel Spacing="8">
                            <TextBlock Text="{DynamicResource ResetMappingsTitle}" FontSize="24" FontWeight="Bold" Foreground="#F3F7FF"/>
                            <TextBlock Text="{DynamicResource ResetMappingsDescription}"
                                       FontSize="15"
                                       Foreground="{DynamicResource TextSecondaryColor}"
                                       TextWrapping="Wrap"
                                       MaxWidth="410"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Content="{DynamicResource Cancel}"
                                Command="{Binding CancelResetToDefaultCommand}"
                                Background="Transparent"
                                Foreground="{DynamicResource TextSecondaryColor}"
                                BorderBrush="{DynamicResource BorderColor}"
                                BorderThickness="1"
                                Padding="20,10"
                                CornerRadius="6"
                                FontSize="14"
                                FontWeight="SemiBold"/>
                        <Button Content="{DynamicResource Reset}"
                                Command="{Binding ConfirmResetToDefaultCommand}"
                                Background="{DynamicResource AccentColor}"
                                Foreground="{DynamicResource AppBackgroundColor}"
                                Padding="28,10"
                                CornerRadius="6"
                                FontSize="14"
                                FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
        <!-- Profile Editor Overlay -->
        <Grid Background="#E60F111A" IsVisible="{Binding IsProfileEditorDialogOpen}" ZIndex="210">
            <Button Command="{Binding CancelProfileEditorCommand}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" CornerRadius="0" BorderThickness="0" Padding="0">
                <Button.Template>
                    <ControlTemplate>
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Border Background="{DynamicResource PanelBackgroundColor}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="34"
                    MaxWidth="520">
                <StackPanel Spacing="18">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding ProfileEditorTitle}" FontSize="24" FontWeight="Bold" Foreground="#F3F7FF"/>
                        <TextBlock Text="{Binding ProfileEditorDescription}"
                                   FontSize="15"
                                   Foreground="{DynamicResource TextSecondaryColor}"
                                   TextWrapping="Wrap"
                                   MaxWidth="410"/>
                    </StackPanel>

                    <TextBox Text="{Binding PendingProfileName, Mode=TwoWay}"
                             FontSize="15"
                             Padding="12,10" />

                    <TextBlock Text="{Binding ProfileEditorError}"
                               IsVisible="{Binding HasProfileEditorError}"
                               Foreground="#D13438"
                               FontSize="13"
                               TextWrapping="Wrap"/>

                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Content="{DynamicResource Cancel}"
                                Command="{Binding CancelProfileEditorCommand}"
                                Background="Transparent"
                                Foreground="{DynamicResource TextSecondaryColor}"
                                BorderBrush="{DynamicResource BorderColor}"
                                BorderThickness="1"
                                Padding="20,10"
                                CornerRadius="6"
                                FontSize="14"
                                FontWeight="SemiBold"/>
                        <Button Content="{DynamicResource Save}"
                                Command="{Binding ConfirmProfileEditorCommand}"
                                Background="{DynamicResource AccentColor}"
                                Foreground="{DynamicResource AppBackgroundColor}"
                                Padding="28,10"
                                CornerRadius="6"
                                FontSize="14"
                                FontWeight="Bold"
                                IsDefault="True"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
        <!-- Remapping Overlay -->
        <views:RemappingOverlayView />

    </Panel>

</Window>
