<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Fondos y Paneles -->
    <SolidColorBrush x:Key="AppBackgroundColor">#0B090B</SolidColorBrush>
    <SolidColorBrush x:Key="PanelBackgroundColor">#171114</SolidColorBrush>
    <SolidColorBrush x:Key="SidebarBackgroundColor">#100C0F</SolidColorBrush>
    <SolidColorBrush x:Key="OverlayBackgroundColor">#E60B090B</SolidColorBrush>
    <SolidColorBrush x:Key="AltPanelBackgroundColor">#21171B</SolidColorBrush>
    <SolidColorBrush x:Key="HeaderBackgroundColor">#2D1B22</SolidColorBrush>

    <!-- Bordes y Divisores -->
    <SolidColorBrush x:Key="BorderColor">#3A252D</SolidColorBrush>
    <SolidColorBrush x:Key="BorderHighlightColor">#5E303D</SolidColorBrush>

    <!-- Textos -->
    <SolidColorBrush x:Key="TextPrimaryColor">#FFF5F7</SolidColorBrush>
    <SolidColorBrush x:Key="TextHeaderColor">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="TextSecondaryColor">#C6A1A9</SolidColorBrush>
    <SolidColorBrush x:Key="TextMutedColor">#8A6670</SolidColorBrush>
    <SolidColorBrush x:Key="TextHighlightColor">#FFD8DE</SolidColorBrush>

    <!-- Color de Acento -->
    <SolidColorBrush x:Key="AccentColor">#FF3B5C</SolidColorBrush>
    <SolidColorBrush x:Key="AccentHoverColor">#4E1725</SolidColorBrush>
    <SolidColorBrush x:Key="AccentSemiTransparentColor">#33FF3B5C</SolidColorBrush>
    <SolidColorBrush x:Key="AccentTransparentColor">#66FF3B5C</SolidColorBrush>

    <!-- Colores RGB para controles de luz -->
    <SolidColorBrush x:Key="RgbRedColor">#FF3B5C</SolidColorBrush>
    <SolidColorBrush x:Key="RgbGreenColor">#5CFF9A</SolidColorBrush>
    <SolidColorBrush x:Key="RgbBlueColor">#7AA7FF</SolidColorBrush>

    <!-- Colores de Estado (Botones predeterminados de ABXY) -->
    <SolidColorBrush x:Key="BtnAColor">#5CFF9A</SolidColorBrush>
    <SolidColorBrush x:Key="BtnBColor">#FF3B5C</SolidColorBrush>
    <SolidColorBrush x:Key="BtnXColor">#7AA7FF</SolidColorBrush>
    <SolidColorBrush x:Key="BtnYColor">#FFD166</SolidColorBrush>
    <SolidColorBrush x:Key="ErrorColor">#FF4A66</SolidColorBrush>
    <SolidColorBrush x:Key="PrimaryActionColor">#C91F42</SolidColorBrush>

    <!-- Mappings y Vectores -->
    <SolidColorBrush x:Key="ActiveMappingColor">#73192D</SolidColorBrush>
    <SolidColorBrush x:Key="InactiveMappingColor">#4A343A</SolidColorBrush>
    <SolidColorBrush x:Key="ControllerBodyColor">#332229</SolidColorBrush>

    <!-- Transparencias de Acento -->
    <SolidColorBrush x:Key="AccentFillSemi">#44FF3B5C</SolidColorBrush>
    <SolidColorBrush x:Key="AccentFillHigh">#77FF3B5C</SolidColorBrush>
    <Color x:Key="AccentGlowStartColor">#88FF3B5C</Color>
    <Color x:Key="AccentGlowEndColor">#00FF3B5C</Color>

    <!-- Ring Color -->
    <SolidColorBrush x:Key="ConnectedRingColor">#405CFF9A</SolidColorBrush>
    <SolidColorBrush x:Key="ConnectedDotColor">#5CFF9A</SolidColorBrush>

    <!-- Toggles -->
    <SolidColorBrush x:Key="ToggleContainerColor">#110C0F</SolidColorBrush>
    <SolidColorBrush x:Key="ToggleCapsuleColor">#30111B</SolidColorBrush>
</ResourceDictionary>
