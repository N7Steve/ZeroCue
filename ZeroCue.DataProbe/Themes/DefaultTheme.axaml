<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Fondos y Paneles -->
    <SolidColorBrush x:Key="AppBackgroundColor">#0F111A</SolidColorBrush>
    <SolidColorBrush x:Key="PanelBackgroundColor">#1A1D27</SolidColorBrush>
    <SolidColorBrush x:Key="SidebarBackgroundColor">#13151D</SolidColorBrush>
    <SolidColorBrush x:Key="OverlayBackgroundColor">#E60F111A</SolidColorBrush>
    <SolidColorBrush x:Key="AltPanelBackgroundColor">#212634</SolidColorBrush>
    <SolidColorBrush x:Key="HeaderBackgroundColor">#2A2E3D</SolidColorBrush>

    <!-- Bordes y Divisores -->
    <SolidColorBrush x:Key="BorderColor">#2D3243</SolidColorBrush>
    <SolidColorBrush x:Key="BorderHighlightColor">#3A415A</SolidColorBrush>

    <!-- Textos -->
    <SolidColorBrush x:Key="TextPrimaryColor">White</SolidColorBrush>
    <SolidColorBrush x:Key="TextHeaderColor">#EAF2FF</SolidColorBrush>
    <SolidColorBrush x:Key="TextSecondaryColor">#8A94A6</SolidColorBrush>
    <SolidColorBrush x:Key="TextMutedColor">#5A6478</SolidColorBrush>
    <SolidColorBrush x:Key="TextHighlightColor">#9AA7BD</SolidColorBrush>

    <!-- Color de Acento -->
    <SolidColorBrush x:Key="AccentColor">#00E5FF</SolidColorBrush>
    <SolidColorBrush x:Key="AccentHoverColor">#144552</SolidColorBrush>
    <SolidColorBrush x:Key="AccentSemiTransparentColor">#3300E5FF</SolidColorBrush>
    <SolidColorBrush x:Key="AccentTransparentColor">#6600E5FF</SolidColorBrush>

    <!-- Colores RGB para controles de luz -->
    <SolidColorBrush x:Key="RgbRedColor">#FF4B4B</SolidColorBrush>
    <SolidColorBrush x:Key="RgbGreenColor">#35F184</SolidColorBrush>
    <SolidColorBrush x:Key="RgbBlueColor">#4B8BFF</SolidColorBrush>

    <!-- Colores de Estado (Botones predeterminados de ABXY) -->
    <SolidColorBrush x:Key="BtnAColor">#4CAF50</SolidColorBrush>
    <SolidColorBrush x:Key="BtnBColor">#F44336</SolidColorBrush>
    <SolidColorBrush x:Key="BtnXColor">#2196F3</SolidColorBrush>
    <SolidColorBrush x:Key="BtnYColor">#FFC107</SolidColorBrush>
    <SolidColorBrush x:Key="ErrorColor">#D13438</SolidColorBrush>
    <SolidColorBrush x:Key="PrimaryActionColor">#0078D7</SolidColorBrush>

    <!-- Mappings y Vectores -->
    <SolidColorBrush x:Key="ActiveMappingColor">#0E6D80</SolidColorBrush>
    <SolidColorBrush x:Key="InactiveMappingColor">#3A415A</SolidColorBrush>
    <SolidColorBrush x:Key="ControllerBodyColor">#303545</SolidColorBrush>

    <!-- Transparencias de Acento -->
    <SolidColorBrush x:Key="AccentFillSemi">#4400E5FF</SolidColorBrush>
    <SolidColorBrush x:Key="AccentFillHigh">#7700E5FF</SolidColorBrush>
    <Color x:Key="AccentGlowStartColor">#8800E5FF</Color>
    <Color x:Key="AccentGlowEndColor">#0000E5FF</Color>

    <!-- Ring Color -->
    <SolidColorBrush x:Key="ConnectedRingColor">#4035F184</SolidColorBrush>
    <SolidColorBrush x:Key="ConnectedDotColor">#35F184</SolidColorBrush>

    <!-- Toggles -->
    <SolidColorBrush x:Key="ToggleContainerColor">#10141D</SolidColorBrush>
    <SolidColorBrush x:Key="ToggleCapsuleColor">#10202B</SolidColorBrush>
</ResourceDictionary>
