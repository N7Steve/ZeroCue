<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Fondos y Paneles (Mas oscuros y grises) -->
    <SolidColorBrush x:Key="AppBackgroundColor">#050505</SolidColorBrush>
    <SolidColorBrush x:Key="PanelBackgroundColor">#111111</SolidColorBrush>
    <SolidColorBrush x:Key="SidebarBackgroundColor">#090909</SolidColorBrush>
    <SolidColorBrush x:Key="OverlayBackgroundColor">#E6000000</SolidColorBrush>
    <SolidColorBrush x:Key="AltPanelBackgroundColor">#181818</SolidColorBrush>
    <SolidColorBrush x:Key="HeaderBackgroundColor">#1E1E1E</SolidColorBrush>

    <!-- Bordes y Divisores -->
    <SolidColorBrush x:Key="BorderColor">#222222</SolidColorBrush>
    <SolidColorBrush x:Key="BorderHighlightColor">#333333</SolidColorBrush>

    <!-- Textos -->
    <SolidColorBrush x:Key="TextPrimaryColor">#EEEEEE</SolidColorBrush>
    <SolidColorBrush x:Key="TextHeaderColor">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="TextSecondaryColor">#A0A0A0</SolidColorBrush>
    <SolidColorBrush x:Key="TextMutedColor">#777777</SolidColorBrush>
    <SolidColorBrush x:Key="TextHighlightColor">#CCCCCC</SolidColorBrush>

    <!-- Color de Acento -->
    <SolidColorBrush x:Key="AccentColor">#FF6A00</SolidColorBrush>
    <SolidColorBrush x:Key="AccentHoverColor">#CC5500</SolidColorBrush>
    <SolidColorBrush x:Key="AccentSemiTransparentColor">#33FF6A00</SolidColorBrush>
    <SolidColorBrush x:Key="AccentTransparentColor">#66FF6A00</SolidColorBrush>

    <!-- Colores RGB para controles de luz -->
    <SolidColorBrush x:Key="RgbRedColor">#FF4B4B</SolidColorBrush>
    <SolidColorBrush x:Key="RgbGreenColor">#FF3B30</SolidColorBrush>
    <SolidColorBrush x:Key="RgbBlueColor">#4B8BFF</SolidColorBrush>

    <!-- Colores de Estado (Botones predeterminados de ABXY) -->
    <SolidColorBrush x:Key="BtnAColor">#FF3B30</SolidColorBrush>
    <SolidColorBrush x:Key="BtnBColor">#F44336</SolidColorBrush>
    <SolidColorBrush x:Key="BtnXColor">#2196F3</SolidColorBrush>
    <SolidColorBrush x:Key="BtnYColor">#FFC107</SolidColorBrush>
    <SolidColorBrush x:Key="ErrorColor">#D13438</SolidColorBrush>
    <SolidColorBrush x:Key="PrimaryActionColor">#FF6A00</SolidColorBrush>

    <!-- Mappings y Vectores -->
    <SolidColorBrush x:Key="ActiveMappingColor">#662B00</SolidColorBrush>
    <SolidColorBrush x:Key="InactiveMappingColor">#636363</SolidColorBrush>
    <SolidColorBrush x:Key="ControllerBodyColor">#343434</SolidColorBrush>

    <!-- Transparencias de Acento -->
    <SolidColorBrush x:Key="AccentFillSemi">#44FF6A00</SolidColorBrush>
    <SolidColorBrush x:Key="AccentFillHigh">#77FF6A00</SolidColorBrush>
    <Color x:Key="AccentGlowStartColor">#88FF6A00</Color>
    <Color x:Key="AccentGlowEndColor">#00FF6A00</Color>

    <!-- Ring Color -->
    <SolidColorBrush x:Key="ConnectedRingColor">#40FF6A00</SolidColorBrush>
    <SolidColorBrush x:Key="ConnectedDotColor">#FF6A00</SolidColorBrush>

    <!-- Toggles -->
    <SolidColorBrush x:Key="ToggleContainerColor">#090909</SolidColorBrush>
    <SolidColorBrush x:Key="ToggleCapsuleColor">#1A0C00</SolidColorBrush>
</ResourceDictionary>
