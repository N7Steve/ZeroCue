                ToolTip.Tip="{Binding RemapVersion, Converter={StaticResource RemapTooltipConverter}, ConverterParameter='X'}"
                ToolTip.Placement="Right" >
        </Button>

        <!-- G1 -->
        <Polyline Classes="mapLine" Points="2148,1631 2148,2000" />
        <Ellipse Classes="mapDot" Canvas.Left="2143" Canvas.Top="1626" />
        <Button Classes="circleLabelBtn" Command="{Binding BeginRemapCommand}" CommandParameter="G1" Classes.active="{Binding GKeyRemaps[0].IsPressed}" Canvas.Left="2088" Canvas.Top="2020"
                Content="{Binding RemapVersion, Converter={StaticResource RemapContentConverter}, ConverterParameter='G1'}"
                ToolTip.Tip="{Binding RemapVersion, Converter={StaticResource RemapTooltipConverter}, ConverterParameter='G1'}"
                ToolTip.Placement="Bottom" >
        </Button>

        <!-- G2 -->
        <Polyline Classes="mapLine" Points="2378,1632 2376,2000" />
        <Ellipse Classes="mapDot" Canvas.Left="2373" Canvas.Top="1627" />
        <Button Classes="circleLabelBtn" Command="{Binding BeginRemapCommand}" CommandParameter="G2" Classes.active="{Binding GKeyRemaps[1].IsPressed}" Canvas.Left="2316" Canvas.Top="2020"
                Content="{Binding RemapVersion, Converter={StaticResource RemapContentConverter}, ConverterParameter='G2'}"
                ToolTip.Tip="{Binding RemapVersion, Converter={StaticResource RemapTooltipConverter}, ConverterParameter='G2'}"
                ToolTip.Placement="Bottom" >
        </Button>

        <!-- G3 -->
        <Polyline Classes="mapLine" Points="2603,1631 2600,2000" />
        <Ellipse Classes="mapDot" Canvas.Left="2598" Canvas.Top="1626" />
        <Button Classes="circleLabelBtn" Command="{Binding BeginRemapCommand}" CommandParameter="G3" Classes.active="{Binding GKeyRemaps[2].IsPressed}" Canvas.Left="2540" Canvas.Top="2020"
                Content="{Binding RemapVersion, Converter={StaticResource RemapContentConverter}, ConverterParameter='G3'}"
                ToolTip.Tip="{Binding RemapVersion, Converter={StaticResource RemapTooltipConverter}, ConverterParameter='G3'}"
                ToolTip.Placement="Bottom" >
        </Button>

        <!-- G4 -->
        <Polyline Classes="mapLine" Points="2823,1632 2824,2000" />
        <Ellipse Classes="mapDot" Canvas.Left="2818" Canvas.Top="1627" />
        <Button Classes="circleLabelBtn" Command="{Binding BeginRemapCommand}" CommandParameter="G4" Classes.active="{Binding GKeyRemaps[3].IsPressed}" Canvas.Left="2764" Canvas.Top="2020"
                Content="{Binding RemapVersion, Converter={StaticResource RemapContentConverter}, ConverterParameter='G4'}"
                ToolTip.Tip="{Binding RemapVersion, Converter={StaticResource RemapTooltipConverter}, ConverterParameter='G4'}"
                ToolTip.Placement="Bottom" >
        </Button>

        <!-- G5 -->
        <Polyline Classes="mapLine" Points="3050,1631 3049,2000" />
        <Ellipse Classes="mapDot" Canvas.Left="3045" Canvas.Top="1626" />
        <Button Classes="circleLabelBtn" Command="{Binding BeginRemapCommand}" CommandParameter="G5" Classes.active="{Binding GKeyRemaps[4].IsPressed}" Canvas.Left="2989" Canvas.Top="2020"
                Content="{Binding RemapVersion, Converter={StaticResource RemapContentConverter}, ConverterParameter='G5'}"
                ToolTip.Tip="{Binding RemapVersion, Converter={StaticResource RemapTooltipConverter}, ConverterParameter='G5'}"
                ToolTip.Placement="Bottom" >
        </Button>

        <!-- View -->
        <Polyline Classes="mapLine" Points="2145,723 2314,723" />
        <Ellipse Classes="mapDot" Canvas.Left="2140" Canvas.Top="718" />
        <Button Classes="labelBtn" Command="{Binding BeginRemapCommand}" CommandParameter="Back" Classes.active="{Binding ButtonBack}" Canvas.Left="2354" Canvas.Top="673" HorizontalAlignment="Center"
                Content="{Binding RemapVersion, Converter={StaticResource RemapContentConverter}, ConverterParameter='Back'}"
                ToolTip.Tip="{Binding RemapVersion, Converter={StaticResource RemapTooltipConverter}, ConverterParameter='Back'}"
                ToolTip.Placement="Bottom" >
        </Button>

        <!-- Menu -->
        <Polyline Classes="mapLine" Points="3058,723 2894,723" />
        <Ellipse Classes="mapDot" Canvas.Left="3053" Canvas.Top="718" />
        <Button Classes="labelBtn" Command="{Binding BeginRemapCommand}" CommandParameter="Start" Classes.active="{Binding ButtonStart}" Canvas.Left="2754" Canvas.Top="673" HorizontalAlignment="Center"
                Content="{Binding RemapVersion, Converter={StaticResource RemapContentConverter}, ConverterParameter='Start'}"
                ToolTip.Tip="{Binding RemapVersion, Converter={StaticResource RemapTooltipConverter}, ConverterParameter='Start'}"
                ToolTip.Placement="Bottom" >
        </Button>

        <!-- LeftThumb -->
        <Polyline Classes="mapLine" Points="2205,1267 1230,1267"  />
        <Ellipse Classes="mapDot" Canvas.Left="2200" Canvas.Top="1262" />
        <Button Classes="labelBtn" Command="{Binding BeginRemapCommand}" CommandParameter="LeftThumb" Classes.active="{Binding ButtonL3}" Canvas.Right="4210" Canvas.Top="1217"
                Content="{Binding RemapVersion, Converter={StaticResource RemapContentConverter}, ConverterParameter='LeftThumb'}"
                ToolTip.Tip="{Binding RemapVersion, Converter={StaticResource RemapTooltipConverter}, ConverterParameter='LeftThumb'}"
                ToolTip.Placement="Left" >
        </Button>

        <!-- RightThumb -->
        <Polyline Classes="mapLine" Points="2984,1267 3960,1267"  />
        <Ellipse Classes="mapDot" Canvas.Left="2979" Canvas.Top="1262" />
        <Button Classes="labelBtn" Command="{Binding BeginRemapCommand}" CommandParameter="RightThumb" Classes.active="{Binding ButtonR3}" Canvas.Left="4000" Canvas.Top="1217"
                Content="{Binding RemapVersion, Converter={StaticResource RemapContentConverter}, ConverterParameter='RightThumb'}"
                ToolTip.Tip="{Binding RemapVersion, Converter={StaticResource RemapTooltipConverter}, ConverterParameter='RightThumb'}"
                ToolTip.Placement="Right" >
        </Button>

        <!-- Guide -->
        <Polyline Classes="mapLine" Points="2596,1266 2604,780" />
        <Ellipse Classes="mapDot" Canvas.Left="2591" Canvas.Top="1261" />
        <Button Classes="labelBtn" Command="{Binding BeginRemapCommand}" CommandParameter="Guide" Classes.active="{Binding ButtonGuide}" Canvas.Left="2554" Canvas.Top="673" HorizontalAlignment="Center"
                Content="{Binding RemapVersion, Converter={StaticResource RemapContentConverter}, ConverterParameter='Guide'}"
                ToolTip.Tip="{Binding RemapVersion, Converter={StaticResource RemapTooltipConverter}, ConverterParameter='Guide'}"
                ToolTip.Placement="Bottom" >
        </Button>

        <!-- Paddle_L4 -->
        <Polyline Classes="mapLine" Points="1853,1460 1230,1460"  />
        <Ellipse Classes="mapDot" Canvas.Left="1848" Canvas.Top="1455" />
        <Button Classes="labelBtn" Command="{Binding BeginRemapCommand}" CommandParameter="Paddle_L4" Classes.active="{Binding PaddleRemaps[2].IsPressed}" Canvas.Right="4210" Canvas.Top="1410"
                Content="{Binding RemapVersion, Converter={StaticResource RemapContentConverter}, ConverterParameter='Paddle_L4'}"
                ToolTip.Tip="{Binding RemapVersion, Converter={StaticResource RemapTooltipConverter}, ConverterParameter='Paddle_L4'}"
                ToolTip.Placement="Left" >
        </Button>

        <!-- Paddle_R4 -->
        <Polyline Classes="mapLine" Points="3339,1457 3960,1457"  />
        <Ellipse Classes="mapDot" Canvas.Left="3334" Canvas.Top="1452" />
        <Button Classes="labelBtn" Command="{Binding BeginRemapCommand}" CommandParameter="Paddle_R4" Classes.active="{Binding PaddleRemaps[0].IsPressed}" Canvas.Left="4000" Canvas.Top="1407"
                Content="{Binding RemapVersion, Converter={StaticResource RemapContentConverter}, ConverterParameter='Paddle_R4'}"
                ToolTip.Tip="{Binding RemapVersion, Converter={StaticResource RemapTooltipConverter}, ConverterParameter='Paddle_R4'}"
                ToolTip.Placement="Right" >
        </Button>

        <!-- Paddle_L5 -->
        <Polyline Classes="mapLine" Points="1785,1753 1230,1753"  />
        <Ellipse Classes="mapDot" Canvas.Left="1780" Canvas.Top="1748" />
        <Button Classes="labelBtn" Command="{Binding BeginRemapCommand}" CommandParameter="Paddle_L5" Classes.active="{Binding PaddleRemaps[3].IsPressed}" Canvas.Right="4210" Canvas.Top="1703"
                Content="{Binding RemapVersion, Converter={StaticResource RemapContentConverter}, ConverterParameter='Paddle_L5'}"
                ToolTip.Tip="{Binding RemapVersion, Converter={StaticResource RemapTooltipConverter}, ConverterParameter='Paddle_L5'}"
                ToolTip.Placement="Left" >
        </Button>

        <!-- Paddle_R5 -->
        <Polyline Classes="mapLine" Points="3420,1755 3960,1755"  />
        <Ellipse Classes="mapDot" Canvas.Left="3415" Canvas.Top="1750" />
        <Button Classes="labelBtn" Command="{Binding BeginRemapCommand}" CommandParameter="Paddle_R5" Classes.active="{Binding PaddleRemaps[1].IsPressed}" Canvas.Left="4000" Canvas.Top="1705"
                Content="{Binding RemapVersion, Converter={StaticResource RemapContentConverter}, ConverterParameter='Paddle_R5'}"
                ToolTip.Tip="{Binding RemapVersion, Converter={StaticResource RemapTooltipConverter}, ConverterParameter='Paddle_R5'}"
                ToolTip.Placement="Right" >
        </Button>
        <!-- Standard / Shift Mode Toggle -->
        <Border Classes="modeToggle" Canvas.Left="2310" Canvas.Top="2320" Width="560" Height="90" Background="{DynamicResource ToggleContainerColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="2" CornerRadius="45" Padding="4">
            <Panel>
                <!-- Animated Capsule -->
                <Border Width="272" HorizontalAlignment="Left" Background="{DynamicResource ToggleCapsuleColor}" CornerRadius="40" Classes.shift="{Binding IsShiftMode}">
                    <Border.Transitions>
                        <Transitions>
                            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="CircularEaseOut" />
                        </Transitions>
                    </Border.Transitions>
                    <Border.Styles>
                        <Style Selector="Border">
                            <Setter Property="RenderTransform" Value="translateX(0px)" />
                        </Style>
                        <Style Selector="Border.shift">
                            <Setter Property="RenderTransform" Value="translateX(276px)" />
                        </Style>
                    </Border.Styles>
                </Border>
                <!-- Buttons -->
                <Grid ColumnDefinitions="*,*">
                    <Button Grid.Column="0" Classes="modeSegment" Classes.active="{Binding !IsShiftMode}" Content="{DynamicResource Standard}" Command="{Binding SetStandardModeCommand}" />
                    <Button Grid.Column="1" Classes="modeSegment" Classes.active="{Binding IsShiftMode}" Content="{DynamicResource Shift}" Command="{Binding SetShiftModeCommand}" />
                </Grid>
            </Panel>
        </Border>

            </Canvas>
            </Panel>
        </Viewbox>
    </Grid>
</UserControl>
