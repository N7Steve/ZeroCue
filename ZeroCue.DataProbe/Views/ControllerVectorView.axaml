        <!-- JOYSTICK DOTS -->
        <Ellipse Classes="stickTelemetryDot" Width="100" Height="100" Fill="{DynamicResource AccentColor}" Opacity="{Binding LeftStickOpacity}" IsHitTestVisible="False" Canvas.Left="{Binding LeftStickKnobX}" Canvas.Top="{Binding LeftStickKnobY}">
            <Ellipse.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="LinearEasing" />
                </Transitions>
            </Ellipse.Transitions>
        </Ellipse>
        <Ellipse Classes="stickTelemetryDot" Width="100" Height="100" Fill="{DynamicResource AccentColor}" Opacity="{Binding RightStickOpacity}" IsHitTestVisible="False" Canvas.Left="{Binding RightStickKnobX}" Canvas.Top="{Binding RightStickKnobY}">
            <Ellipse.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="LinearEasing" />
                </Transitions>
            </Ellipse.Transitions>
        </Ellipse>

