<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ZeroCue.DataProbe.ViewModels"
             xmlns:conv="using:ZeroCue.DataProbe.Converters"
             x:Class="ZeroCue.DataProbe.Views.ControllerVectorView"
             x:DataType="vm:MainViewModel">

    <UserControl.Resources>
        <conv:RemapBrushConverter x:Key="RemapBrushConverter"/>
        <conv:RemapTooltipConverter x:Key="RemapTooltipConverter"/>
        <conv:RemapContentConverter x:Key="RemapContentConverter"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.remapBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.remapBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSemiTransparentColor}"/>
        </Style>
        <Style Selector="Button.remapBtn:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentTransparentColor}"/>
        </Style>

        <Style Selector="TextBlock.mapText">
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
            <Setter Property="FontSize" Value="48"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.mapLabel">
            <Setter Property="Foreground" Value="{DynamicResource TextHeaderColor}"/>
            <Setter Property="FontSize" Value="42"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Segoe UI, Inter, Arial"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="Polyline.mapLine">
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Stroke" Value="{DynamicResource TextMutedColor}"/>
            <Setter Property="StrokeThickness" Value="3"/>
            <Setter Property="StrokeJoin" Value="Round"/>
        </Style>
        <Style Selector="Ellipse.mapDot">
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Fill" Value="{DynamicResource TextHeaderColor}"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
        </Style>

                        <Style Selector="Button.labelBtn /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.08" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.08" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.labelBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentHoverColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
        </Style>
        <Style Selector="Button.labelBtn.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ActiveMappingColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
        </Style>


        <Style Selector="Button.pathRemapBtn">
            <Setter Property="Background" Value="{x:Null}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.pathRemapBtn :is(Shape).btnPath">
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.pathRemapBtn :is(Shape).btnPath">
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Fill" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.pathRemapBtn:pointerover :is(Shape).btnPath">
            <Setter Property="Fill" Value="{DynamicResource AccentFillSemi}"/>
        </Style>
        <Style Selector="Button.pathRemapBtn.active :is(Shape).btnPath">
            <Setter Property="Fill" Value="{DynamicResource AccentFillSemi}"/>
        </Style>
        <Style Selector="Button.pathRemapBtn.linkedHover :is(Shape).btnPath">
            <Setter Property="Fill" Value="{DynamicResource AccentFillSemi}"/>
        </Style>
        <Style Selector="Button.pathRemapBtn:pressed :is(Shape).btnPath">
            <Setter Property="Fill" Value="{DynamicResource AccentFillHigh}"/>
        </Style>


        <Style Selector="Button.dpadUp :is(Shape).btnPath">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Fill" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.dpadUp:pointerover :is(Shape).btnPath, Button.dpadUp.linkedHover :is(Shape).btnPath">
            <Setter Property="Fill">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                        <GradientStop Color="{DynamicResource AccentGlowStartColor}" Offset="0.1" />
                        <GradientStop Color="{DynamicResource AccentGlowEndColor}" Offset="0.9" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="Button.dpadUp.active :is(Shape).btnPath">
            <Setter Property="Fill">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                        <GradientStop Color="{DynamicResource AccentGlowStartColor}" Offset="0.1" />
                        <GradientStop Color="{DynamicResource AccentGlowEndColor}" Offset="0.9" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="Button.dpadDown :is(Shape).btnPath">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Fill" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.dpadDown:pointerover :is(Shape).btnPath, Button.dpadDown.linkedHover :is(Shape).btnPath">
            <Setter Property="Fill">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="50%,100%" EndPoint="50%,0%">
                        <GradientStop Color="{DynamicResource AccentGlowStartColor}" Offset="0.1" />
                        <GradientStop Color="{DynamicResource AccentGlowEndColor}" Offset="0.9" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="Button.dpadDown.active :is(Shape).btnPath">
            <Setter Property="Fill">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="50%,100%" EndPoint="50%,0%">
                        <GradientStop Color="{DynamicResource AccentGlowStartColor}" Offset="0.1" />
                        <GradientStop Color="{DynamicResource AccentGlowEndColor}" Offset="0.9" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="Button.dpadLeft :is(Shape).btnPath">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Fill" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.dpadLeft:pointerover :is(Shape).btnPath, Button.dpadLeft.linkedHover :is(Shape).btnPath">
            <Setter Property="Fill">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                        <GradientStop Color="{DynamicResource AccentGlowStartColor}" Offset="0.1" />
                        <GradientStop Color="{DynamicResource AccentGlowEndColor}" Offset="0.9" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="Button.dpadLeft.active :is(Shape).btnPath">
            <Setter Property="Fill">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                        <GradientStop Color="{DynamicResource AccentGlowStartColor}" Offset="0.1" />
                        <GradientStop Color="{DynamicResource AccentGlowEndColor}" Offset="0.9" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="Button.dpadRight :is(Shape).btnPath">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Fill" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.dpadRight:pointerover :is(Shape).btnPath, Button.dpadRight.linkedHover :is(Shape).btnPath">
            <Setter Property="Fill">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="100%,50%" EndPoint="0%,50%">
                        <GradientStop Color="{DynamicResource AccentGlowStartColor}" Offset="0.1" />
                        <GradientStop Color="{DynamicResource AccentGlowEndColor}" Offset="0.9" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="Button.dpadRight.active :is(Shape).btnPath">
            <Setter Property="Fill">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="100%,50%" EndPoint="0%,50%">
                        <GradientStop Color="{DynamicResource AccentGlowStartColor}" Offset="0.1" />
                        <GradientStop Color="{DynamicResource AccentGlowEndColor}" Offset="0.9" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>


                        <Style Selector="Button.labelBtn, Button.circleLabelBtn">
            <Setter Property="Background" Value="{DynamicResource InactiveMappingColor}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="4"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="100"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.circleLabelBtn /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.08" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.08" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.circleLabelBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentHoverColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
        </Style>
        <Style Selector="Button.circleLabelBtn.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ActiveMappingColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
        </Style>

        <Style Selector="Button.modeSegment">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8A94A6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="FontSize" Value="44"/>
            <Setter Property="CornerRadius" Value="30"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.modeSegment:pointerover">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextHeaderColor}"/>
        </Style>
        <Style Selector="Button.modeSegment.active">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
        </Style>

        <Style Selector=":is(UserControl).controllerSilhouette Button.labelBtn">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector=":is(UserControl).controllerSilhouette Button.circleLabelBtn">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector=":is(UserControl).controllerSilhouette Polyline.mapLine">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector=":is(UserControl).controllerSilhouette Ellipse.mapDot">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector=":is(UserControl).controllerSilhouette Border.modeToggle">
            <Setter Property="IsVisible" Value="False"/>
        </Style>

</UserControl.Styles>

    <Grid RowDefinitions="*, Auto">
        <Viewbox Grid.Row="0" Stretch="Uniform" Margin="0">
            <!-- Wrap the Canvas in a Panel to crop empty space -->
            <Panel x:Name="ControllerCropPanel" Width="3700" Height="2500" ClipToBounds="False">
                <Canvas x:Name="ControllerOuterCanvas" Width="5400" Height="2508" Margin="-750, 40, 0, 0" HorizontalAlignment="Left" VerticalAlignment="Top">
                <!-- Controller SVG base shifted by 1350px to the right -->
                <Canvas Canvas.Left="1350" Width="2508" Height="2508" Background="Transparent">

                    <!-- Masking canvas to hide elements when they are behind the controller -->
                    <Canvas Canvas.Left="0" Canvas.Top="-1000" Width="2508" Height="1510.53" ClipToBounds="True" ZIndex="2">
                        <!-- USB Cable Animation -->
                        <Canvas x:Name="UsbCableCanvas" Canvas.Left="1189.75" Canvas.Top="-139.5" Width="132" Height="1650">
                            <Canvas.RenderTransform>
                                <TranslateTransform Y="-1650" />
                            </Canvas.RenderTransform>
                            <Path Stroke="{DynamicResource ControllerBodyColor}"
                                  StrokeThickness="8"
                                  StrokeLineCap="Round"
                                  Data="M 50 0 L 50 1508 M 82 0 L 82 1508" />
                            <Path Stroke="{DynamicResource ControllerBodyColor}"
                                  StrokeThickness="9"
                                  StrokeJoin="Round"
                                  Fill="Transparent"
                                  Data="M 30 1608 L 30 1530 Q 30 1508 52 1508 L 80 1508 Q 102 1508 102 1530 L 102 1608 Z" />
                            <Path Stroke="{DynamicResource ControllerBodyColor}"
                                  StrokeThickness="8"
                                  StrokeJoin="Round"
                                  Fill="Transparent"
                                  Data="M 42 1646 L 90 1646 L 90 1608 L 42 1608 Z" />
                            <Path Stroke="{DynamicResource ControllerBodyColor}"
                                  StrokeThickness="6"
                                  StrokeLineCap="Round"
                                  Data="M 50 1548 L 82 1548 M 50 1580 L 82 1580" />
                        </Canvas>

                        <!-- RF Dongle Animation -->
                        <Viewbox x:Name="RfDongleViewbox" Width="150" Height="500" Canvas.Left="1180.75" Canvas.Top="1510.53" Opacity="0">
                            <Viewbox.RenderTransform>
                                <RotateTransform Angle="0" CenterX="75" CenterY="250" />
                            </Viewbox.RenderTransform>
                            <Canvas Width="1063" Height="3560">
                                <Canvas.RenderTransform>
                                    <TranslateTransform X="-1468" Y="-220" />
                            </Canvas.RenderTransform>
                            <Path Fill="{DynamicResource ControllerBodyColor}" Data="M 1627.93 221.125 L 2080.29 220.699 L 2249.05 220.719 C 2272.55 220.734 2355.37 218.247 2371.03 226.653 C 2375.27 249.709 2374.29 293.597 2374.35 318.266 L 2374.43 465.107 L 2373.83 981.173 C 2415.22 981.236 2479.24 963.207 2510.2 990.942 C 2524.72 1004.62 2527.31 1022.73 2527.15 1042.34 C 2526.19 1158.62 2529.52 1275.91 2525.72 1391.91 C 2525.18 1408.35 2486.99 1424.96 2492.13 1444.42 C 2497.62 1465.23 2530.15 1455.41 2531.41 1482.33 C 2532.26 1508.16 2531.84 1534.24 2531.84 1560.16 L 2531.8 1726.96 L 2531.56 2272.73 L 2530.86 3193.29 L 2530.92 3515.4 C 2530.92 3571.06 2531.22 3627.13 2530.51 3682.76 C 2530.26 3702.3 2527.93 3718.98 2514.6 3734.31 C 2482.51 3771.2 2411.98 3774.61 2366.7 3777.66 C 2326.23 3780.27 2273.84 3778.95 2232.43 3778.96 L 2003.23 3778.96 L 1782.78 3778.96 C 1708.24 3778.96 1633.78 3780.48 1559.72 3767.19 C 1525.16 3761 1476.83 3745.36 1471.43 3702.92 C 1469.28 3686.07 1470.18 3662.68 1470.09 3645.38 L 1469.97 3538.43 L 1470.08 3211.78 L 1470.03 1849.49 C 1470.05 1724.63 1468.77 1599.29 1471.62 1474.52 C 1471.99 1458.17 1533.52 1458.18 1499.14 1424.41 C 1488.66 1414.11 1469.99 1406.27 1469.3 1388.69 C 1467.89 1352.67 1468.48 1316.72 1468.52 1280.83 L 1468.36 1065.38 C 1468.39 945.706 1526.55 979.205 1615.68 981.001 L 1615.3 447.38 L 1615.26 300.008 C 1615.27 278.912 1614.78 255.192 1616.31 234.111 C 1616.66 229.198 1623.86 224.313 1627.93 221.125 z M 2496.35 3729.95 C 2507.56 3718.39 2512.79 3708.36 2513.29 3691.74 C 2514.07 3665.6 2513.41 3638.24 2513.45 3612.02 L 2513.64 3442.65 L 2513.68 2917.48 L 2514.13 1955.7 C 2514.14 1806.36 2516.4 1651.76 2514.16 1502.88 C 2514.1 1494.71 2513.62 1486.55 2512.71 1478.44 C 2509.88 1476.11 2505.87 1471.66 2501.45 1473.82 C 2477.7 1485.4 2449.5 1490.12 2423.24 1491.82 C 2369.67 1495.27 2315.09 1494.04 2261.39 1494.03 L 1994.72 1493.9 L 1740.05 1493.9 C 1678.6 1493.91 1616.32 1496.09 1555.16 1488.8 C 1530.12 1485.81 1516.