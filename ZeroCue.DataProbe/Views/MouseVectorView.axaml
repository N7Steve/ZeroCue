<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ZeroCue.DataProbe.ViewModels"
             xmlns:conv="using:ZeroCue.DataProbe.Converters"
             x:Class="ZeroCue.DataProbe.Views.MouseVectorView"
             x:DataType="vm:MainViewModel">

    <UserControl.Resources>
        <conv:RemapBrushConverter x:Key="RemapBrushConverter"/>
        <conv:RemapTooltipConverter x:Key="RemapTooltipConverter"/>
        <conv:RemapContentConverter x:Key="RemapContentConverter"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.remapBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.remapBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSemiTransparentColor}"/>
        </Style>
        <Style Selector="Button.remapBtn:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentTransparentColor}"/>
        </Style>

        <Style Selector="TextBlock.mapText">
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
            <Setter Property="FontSize" Value="48"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.mapLabel">
            <Setter Property="Foreground" Value="{DynamicResource TextHeaderColor}"/>
            <Setter Property="FontSize" Value="42"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Segoe UI, Inter, Arial"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.systemButtonLabel">
            <Setter Property="Foreground" Value="{DynamicResource TextHeaderColor}"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Segoe UI, Inter, Arial"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <Style Selector="Polyline.mapLine">
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Stroke" Value="{DynamicResource TextMutedColor}"/>
            <Setter Property="StrokeThickness" Value="3"/>
            <Setter Property="StrokeJoin" Value="Round"/>
        </Style>
        <Style Selector="Ellipse.mapDot">
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Fill" Value="{DynamicResource TextHeaderColor}"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
        </Style>

                        <Style Selector="Button.labelBtn /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.08" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.08" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.labelBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentHoverColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
        </Style>
        <Style Selector="Button.labelBtn.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ActiveMappingColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
        </Style>


        <Style Selector="Button.pathRemapBtn">
            <Setter Property="Background" Value="{x:Null}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.pathRemapBtn :is(Shape).btnPath">
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.pathRemapBtn :is(Shape).btnPath">
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Fill" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.pathRemapBtn:pointerover :is(Shape).btnPath">
            <Setter Property="Fill" Value="{DynamicResource AccentFillSemi}"/>
        </Style>
        <Style Selector="Button.pathRemapBtn.active :is(Shape).btnPath">
            <Setter Property="Fill" Value="{DynamicResource AccentFillSemi}"/>
        </Style>
        <Style Selector="Button.pathRemapBtn:pressed :is(Shape).btnPath">
            <Setter Property="Fill" Value="{DynamicResource AccentFillHigh}"/>
        </Style>


        <Style Selector="Button.dpadUp :is(Shape).btnPath">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Fill" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.dpadUp:pointerover :is(Shape).btnPath">
            <Setter Property="Fill">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                        <GradientStop Color="{DynamicResource AccentGlowStartColor}" Offset="0.1" />
                        <GradientStop Color="{DynamicResource AccentGlowEndColor}" Offset="0.9" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="Button.dpadUp.active :is(Shape).btnPath">
            <Setter Property="Fill">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                        <GradientStop Color="{DynamicResource AccentGlowStartColor}" Offset="0.1" />
                        <GradientStop Color="{DynamicResource AccentGlowEndColor}" Offset="0.9" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="Button.dpadDown :is(Shape).btnPath">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Fill" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.dpadDown:pointerover :is(Shape).btnPath">
            <Setter Property="Fill">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="50%,100%" EndPoint="50%,0%">
                        <GradientStop Color="{DynamicResource AccentGlowStartColor}" Offset="0.1" />
                        <GradientStop Color="{DynamicResource AccentGlowEndColor}" Offset="0.9" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="Button.dpadDown.active :is(Shape).btnPath">
            <Setter Property="Fill">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="50%,100%" EndPoint="50%,0%">
                        <GradientStop Color="{DynamicResource AccentGlowStartColor}" Offset="0.1" />
                        <GradientStop Color="{DynamicResource AccentGlowEndColor}" Offset="0.9" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="Button.dpadLeft :is(Shape).btnPath">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Fill" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.dpadLeft:pointerover :is(Shape).btnPath">
            <Setter Property="Fill">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                        <GradientStop Color="{DynamicResource AccentGlowStartColor}" Offset="0.1" />
                        <GradientStop Color="{DynamicResource AccentGlowEndColor}" Offset="0.9" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="Button.dpadLeft.active :is(Shape).btnPath">
            <Setter Property="Fill">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                        <GradientStop Color="{DynamicResource AccentGlowStartColor}" Offset="0.1" />
                        <GradientStop Color="{DynamicResource AccentGlowEndColor}" Offset="0.9" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="Button.dpadRight :is(Shape).btnPath">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Fill" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.dpadRight:pointerover :is(Shape).btnPath">
            <Setter Property="Fill">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="100%,50%" EndPoint="0%,50%">
                        <GradientStop Color="{DynamicResource AccentGlowStartColor}" Offset="0.1" />
                        <GradientStop Color="{DynamicResource AccentGlowEndColor}" Offset="0.9" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="Button.dpadRight.active :is(Shape).btnPath">
            <Setter Property="Fill">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="100%,50%" EndPoint="0%,50%">
                        <GradientStop Color="{DynamicResource AccentGlowStartColor}" Offset="0.1" />
                        <GradientStop Color="{DynamicResource AccentGlowEndColor}" Offset="0.9" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <Style Selector="Button.arrowRemapBtn :is(Shape).arrowHitArea">
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Fill" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.arrowRemapBtn:pointerover :is(Shape).arrowHitArea">
            <Setter Property="Fill" Value="Transparent"/>
        </Style>
        <Style Selector="Button.arrowRemapBtn:pressed :is(Shape).arrowHitArea">
            <Setter Property="Fill" Value="Transparent"/>
        </Style>
        <Style Selector="Button.arrowRemapBtn.active :is(Shape).arrowHitArea">
            <Setter Property="Fill" Value="Transparent"/>
        </Style>
        <Style Selector="Button.arrowRemapBtn :is(Shape).arrowGlow">
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Fill" Duration="0:0:0.16" />
                    <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.arrowRemapBtn:pointerover :is(Shape).arrowGlow">
            <Setter Property="Fill" Value="{DynamicResource AccentSemiTransparentColor}"/>
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
        <Style Selector="Button.arrowRemapBtn.active :is(Shape).arrowGlow">
            <Setter Property="Fill" Value="{DynamicResource AccentSemiTransparentColor}"/>
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
        <Style Selector="Button.arrowRemapBtn :is(Shape).arrowGlyph">
            <Setter Property="Fill" Value="{DynamicResource TextMutedColor}"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Fill" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.arrowRemapBtn:pointerover :is(Shape).arrowGlyph">
            <Setter Property="Fill" Value="{DynamicResource AccentColor}"/>
        </Style>
        <Style Selector="Button.arrowRemapBtn.active :is(Shape).arrowGlyph">
            <Setter Property="Fill" Value="{DynamicResource AccentColor}"/>
        </Style>


                        <Style Selector="Button.labelBtn, Button.circleLabelBtn">
            <Setter Property="Background" Value="{DynamicResource InactiveMappingColor}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="4"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="100"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.circleLabelBtn /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.08" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.08" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.circleLabelBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentHoverColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
        </Style>
        <Style Selector="Button.circleLabelBtn.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ActiveMappingColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
        </Style>

        <Style Selector="Button.modeSegment">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8A94A6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="FontSize" Value="44"/>
            <Setter Property="CornerRadius" Value="30"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.modeSegment:pointerover">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextHeaderColor}"/>
        </Style>
        <Style Selector="Button.modeSegment.active">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
        </Style>

</UserControl.Styles>

<Grid RowDefinitions="*, Auto">
    <Viewbox Grid.Row="0" Stretch="Uniform" Margin="0">
        <Panel Width="4000" Height="4000" ClipToBounds="False">
            <Canvas Width="4000" Height="4000" HorizontalAlignment="Left" VerticalAlignment="Top">
<!-- BACKGROUND / BODY -->
