<!-- MOUSE MOVE UP -->
<Button Classes="pathRemapBtn dpadUp arrowRemapBtn" Command="{Binding BeginRemapCommand}" CommandParameter="MouseMoveUp" Classes.active="{Binding ButtonMouseMoveUp}" Canvas.Left="1955" Canvas.Top="100">
    <Panel>
        <Ellipse Classes="arrowHitArea" Width="190" Height="190" Margin="-45,-45,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
        <Polygon Classes="arrowGlow" Points="50,-22 -22,122 122,122" />
        <Polygon Classes="arrowGlyph" Points="50,0 0,100 100,100" />
        <Polygon Classes="btnPath" Points="50,0 0,100 100,100" />
    </Panel>
</Button>

<!-- MOUSE MOVE DOWN -->
