<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="560"
             x:Class="ZeroCue.DataProbe.Views.TriggersView">
    <UserControl.Styles>
        <Style Selector="RadioButton.curveBtn">
            <Setter Property="Background" Value="{DynamicResource ToggleContainerColor}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryColor}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.curveBtn:pointerover">
            <Setter Property="Foreground" Value="#EAF2FF" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderHighlightColor}" />
        </Style>
        <Style Selector="RadioButton.curveBtn:checked">
            <Setter Property="Background" Value="{DynamicResource AccentSemiTransparentColor}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}" />
        </Style>
            <Style Selector="Thumb.curveDot">
            <Setter Property="Template">
                <ControlTemplate>
                    <Ellipse Width="12" Height="12" Fill="{DynamicResource AccentColor}" Stroke="White" StrokeThickness="1" />
                </ControlTemplate>
            </Setter>
        </Style>
    </UserControl.Styles>

            <Grid MaxWidth="1000" RowDefinitions="Auto,Auto" Background="{DynamicResource AppBackgroundColor}" Margin="28">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,18">
            <StackPanel Spacing="5">
                <TextBlock Text="{DynamicResource TriggersTitle}" Foreground="White" FontSize="25" FontWeight="SemiBold" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <RadioButton Classes="curveBtn"
                             GroupName="TriggerCurve"
                             Content="{DynamicResource LinearCurve}"
                             Command="{Binding SetTriggerCurveCommand}"
                             CommandParameter="Lineal"
                             IsChecked="{Binding IsTriggerCurveLineal, Mode=OneWay}" />
                <RadioButton Classes="curveBtn"
                             GroupName="TriggerCurve"
                             Content="{DynamicResource ExponentialCurve}"
                             Command="{Binding SetTriggerCurveCommand}"
                             CommandParameter="Exponencial"
                             IsChecked="{Binding IsTriggerCurveExponencial, Mode=OneWay}" />
                <RadioButton Classes="curveBtn"
                             GroupName="TriggerCurve"
                             Content="{DynamicResource DynamicCurve}"
                             Command="{Binding SetTriggerCurveCommand}"
                             CommandParameter="Dinamica"
                             IsChecked="{Binding IsTriggerCurveDinamica, Mode=OneWay}" />
                <RadioButton Classes="curveBtn"
                             GroupName="TriggerCurve"
                             Content="{DynamicResource AggressiveCurve}"
                             Command="{Binding SetTriggerCurveCommand}"
                             CommandParameter="Agresiva"
                             IsChecked="{Binding IsTriggerCurveAgresiva, Mode=OneWay}" />
                <RadioButton Classes="curveBtn"
                             GroupName="TriggerCurve"
                             Content="{DynamicResource CustomCurve}"
                             Command="{Binding SetTriggerCurveCommand}"
                             CommandParameter="Custom"
                             IsChecked="{Binding IsTriggerCurveCustom, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="1.2*,1*,1.2*">
            <Border Grid.Column="0"
                    Background="{DynamicResource PanelBackgroundColor}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14">
                <Grid RowDefinitions="Auto,*,Auto">
                    <TextBlock Text="{DynamicResource LeftTrigger}" Foreground="White" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />

                    <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,20,0,0">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                            <TextBlock Text="{DynamicResource PhysicalInput}" Foreground="{DynamicResource TextSecondaryColor}" FontSize="10" FontWeight="Normal" />
                            <TextBlock Grid.Column="1" Text="{Binding SmoothedLeftTriggerPercent, StringFormat={}{0:0}%}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                        </Grid>
                        <ProgressBar Grid.Row="1" Minimum="0" Maximum="100" Value="{Binding SmoothedLeftTriggerPercent}" Height="6" CornerRadius="3" Foreground="{DynamicResource AccentColor}" Background="{DynamicResource ToggleContainerColor}" />

                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,16,0,6">
                            <TextBlock Text="{DynamicResource CurveOutput}" Foreground="{DynamicResource TextSecondaryColor}" FontSize="10" FontWeight="Normal" />
                            <TextBlock Grid.Column="1" Text="{Binding SmoothedLeftTriggerOutputPercent, StringFormat={}{0:0}%}" Foreground="{DynamicResource RgbGreenColor}" FontSize="12" FontWeight="SemiBold" />
                        </Grid>
                        <ProgressBar Grid.Row="3" Minimum="0" Maximum="100" Value="{Binding SmoothedLeftTriggerOutputPercent}" Height="6" CornerRadius="3" Foreground="{DynamicResource RgbGreenColor}" Background="{DynamicResource ToggleContainerColor}" />
                    </Grid>

                    <Grid Grid.Row="2" ColumnDefinitions="*,*" Margin="0,20,0,0">
                        <Border Background="{DynamicResource AltPanelBackgroundColor}" CornerRadius="8" Padding="10">
                            <StackPanel Spacing="1">
                                <TextBlock Text="RAW" Foreground="{DynamicResource TextMutedColor}" FontSize="8" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding LeftTrigger}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock Text="/ 1023" Foreground="{DynamicResource TextMutedColor}" FontSize="8" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{DynamicResource AltPanelBackgroundColor}" CornerRadius="8" Padding="10" Margin="8,0,0,0">
                            <StackPanel Spacing="1">
                                <TextBlock Text="OUT" Foreground="{DynamicResource TextMutedColor}" FontSize="8" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding LeftTriggerOutputByte}" Foreground="{DynamicResource RgbGreenColor}" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock Text="/ 255" Foreground="{DynamicResource TextMutedColor}" FontSize="8" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Background="{DynamicResource PanelBackgroundColor}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14"
                    Margin="14,0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource ActiveCurve}" Foreground="White" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedTriggerCurveDisplayName}" Foreground="{DynamicResource AccentColor}" FontSize="10" FontWeight="SemiBold" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="{DynamicResource AltPanelBackgroundColor}" CornerRadius="8" Padding="10,6" VerticalAlignment="Top">
                            <TextBlock Text="{Binding TriggerDeltaText}" Foreground="{DynamicResource TextSecondaryColor}" FontSize="10" FontWeight="SemiBold" />
                        </Border>
                    </Grid>

                    <Border Grid.Row="1" Background="{DynamicResource ToggleContainerColor}" CornerRadius="8" Margin="0,10" Padding="14">
                        <Grid>
                            <Viewbox Stretch="Uniform">
                                <Canvas Width="250" Height="130" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Line StartPoint="0,120" EndPoint="240,120" Stroke="{DynamicResource BorderHighlightColor}" StrokeThickness="1" />
                                    <Line StartPoint="0,0" EndPoint="0,120" Stroke="{DynamicResource BorderHighlightColor}" StrokeThickness="1" />
                                    <Line StartPoint="0,90" EndPoint="240,90" Stroke="{DynamicResource BorderColor}" StrokeThickness="1" />
                                    <Line StartPoint="0,60" EndPoint="240,60" Stroke="{DynamicResource BorderColor}" StrokeThickness="1" />
                                    <Line StartPoint="0,30" EndPoint="240,30" Stroke="{DynamicResource BorderColor}" StrokeThickness="1" />
                                    <Line StartPoint="60,0" EndPoint="60,120" Stroke="{DynamicResource BorderColor}" StrokeThickness="1" />
                                    <Line StartPoint="120,0" EndPoint="120,120" Stroke="{DynamicResource BorderColor}" StrokeThickness="1" />
                                    <Line StartPoint="180,0" EndPoint="180,120" Stroke="{DynamicResource BorderColor}" StrokeThickness="1" />

                                    <Polyline Points="0,120 240,0"
                                          Stroke="{DynamicResource AccentColor}"
                                          StrokeThickness="2"
                                          StrokeLineCap="Round"
                                          StrokeJoin="Round"
                                          IsVisible="{Binding IsTriggerCurveLineal}" />
                                    <Polyline Points="0,120.0 5,119.9 10,119.5 15,119.1 20,118.4 25,117.7 30,116.8 35,115.9 40,114.8 45,113.6 50,112.3 55,110.9 60,109.4 65,107.8 70,106.1 75,104.3 80,102.5 85,100.5 90,98.4 95,96.3 100,94.1 105,91.8 110,89.4 115,86.9 120,84.3 125,81.7 130,79.0 135,76.2 140,73.3 145,70.3 150,67.3 155,64.2 160,61.0 165,57.7 170,54.4 175,51.0 180,47.5 185,43.9 190,40.3 195,36.6 200,32.8 205,28.9 210,25.0 215,21.0 220,16.9 225,12.8 230,8.6 235,4.3 240,0.0"
                                          Stroke="{DynamicResource AccentColor}"
                                          StrokeThickness="2"
                                          StrokeLineCap="Round"
                                          StrokeJoin="Round"
                                          IsVisible="{Binding IsTriggerCurveExponencial}" />
                                    <Polyline Points="0,120.0 5,114.9 10,110.2 15,105.7 20,101.6 25,97.7 30,94.2 35,90.9 40,87.8 45,84.9 50,82.3 55,79.9 60,77.6 65,75.6 70,73.6 75,71.9 80,70.2 85,68.7 90,67.3 95,65.9 100,64.7 105,63.4 110,62.3 115,61.1 120,60.0 125,58.9 130,57.7 135,56.6 140,55.3 145,54.1 150,52.7 155,51.3 160,49.8 165,48.1 170,46.4 175,44.4 180,42.4 185,40.1 190,37.7 195,35.1 200,32.2 205,29.1 210,25.8 215,22.3 220,18.4 225,14.3 230,9.8 235,5.1 240,0.0"
                                          Stroke="{DynamicResource AccentColor}"
                                          StrokeThickness="2"
                                          StrokeLineCap="Round"
                                          StrokeJoin="Round"
                                          IsVisible="{Binding IsTriggerCurveDinamica}" />
                                    <Polyline Points="0,120.0 5,114.2 10,108.6 15,103.1 20,97.8 25,92.7 30,87.7 35,82.9 40,78.2 45,73.7 50,69.3 55,65.1 60,61.0 65,57.1 70,53.4 75,49.7 80,46.3 85,43.0 90,39.8 95,36.7 100,33.8 105,31.0 110,28.4 115,25.9 120,23.5 125,21.3 130,19.2 135,17.2 140,15.3 145,13.6 150,12.0 155,10.5 160,9.1 165,7.8 170,6.6 175,5.6 180,4.6 185,3.8 190,3.0 195,2.3 200,1.8 205,1.3 210,0.9 215,0.6 220,0.3 225,0.2 230,0.1 235,0.0 240,0.0"
                                          Stroke="{DynamicResource AccentColor}"
                                          StrokeThickness="2"
                                          StrokeLineCap="Round"
                                          StrokeJoin="Round"
                                          IsVisible="{Binding IsTriggerCurveAgresiva}" />
                                    <Polyline Points="{Binding CustomCurvePoints}"
                                          Stroke="{DynamicResource AccentColor}"
                                          StrokeThickness="2"
                                          StrokeLineCap="Round"
                                          StrokeJoin="Round"
                                          IsVisible="{Binding IsTriggerCurveCustom}" />

                                    <Thumb Name="Thumb0" Classes="curveDot" IsVisible="{Binding IsTriggerCurveCustom}" Canvas.Left="-8" Canvas.Top="112" DragDelta="OnThumbDragDelta" />
                                    <Thumb Name="Thumb1" Classes="curveDot" IsVisible="{Binding IsTriggerCurveCustom}" Canvas.Left="52" Canvas.Top="82" DragDelta="OnThumbDragDelta" />
                                    <Thumb Name="Thumb2" Classes="curveDot" IsVisible="{Binding IsTriggerCurveCustom}" Canvas.Left="112" Canvas.Top="52" DragDelta="OnThumbDragDelta" />
                                    <Thumb Name="Thumb3" Classes="curveDot" IsVisible="{Binding IsTriggerCurveCustom}" Canvas.Left="172" Canvas.Top="22" DragDelta="OnThumbDragDelta" />
                                    <Thumb Name="Thumb4" Classes="curveDot" IsVisible="{Binding IsTriggerCurveCustom}" Canvas.Left="232" Canvas.Top="-8" DragDelta="OnThumbDragDelta" />

                                    <Ellipse Width="10" Height="10" Fill="{DynamicResource RgbGreenColor}" Stroke="#0F111A" StrokeThickness="1" Opacity="0.78" Canvas.Left="{Binding SmoothedLeftTriggerMarkerX}" Canvas.Top="{Binding SmoothedLeftTriggerMarkerY}" />
                                    <Ellipse Width="10" Height="10" Fill="{DynamicResource AccentColor}" Stroke="#0F111A" StrokeThickness="1" Opacity="0.78" Canvas.Left="{Binding SmoothedRightTriggerMarkerX}" Canvas.Top="{Binding SmoothedRightTriggerMarkerY}" />
                                </Canvas>
                            </Viewbox>
                        </Grid>
                    </Border>




                    <Grid Grid.Row="2" ColumnDefinitions="*,*">
                        <Border Background="{DynamicResource AltPanelBackgroundColor}" CornerRadius="8" Padding="10">
                            <Grid ColumnDefinitions="Auto,*">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource RgbGreenColor}" VerticalAlignment="Center" Opacity="0.85" />
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="{DynamicResource LtOnCurve}" Foreground="White" FontSize="10" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding LeftTriggerInputText}" Foreground="{DynamicResource TextSecondaryColor}" FontSize="9" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Background="{DynamicResource AltPanelBackgroundColor}" CornerRadius="8" Padding="10" Margin="8,0,0,0">
                            <Grid ColumnDefinitions="Auto,*">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentColor}" VerticalAlignment="Center" Opacity="0.85" />
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="{DynamicResource RtOnCurve}" Foreground="White" FontSize="10" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding RightTriggerInputText}" Foreground="{DynamicResource TextSecondaryColor}" FontSize="9" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="{DynamicResource PanelBackgroundColor}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14">
                <Grid RowDefinitions="Auto,*,Auto">
                    <TextBlock Text="{DynamicResource RightTrigger}" Foreground="White" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />

                    <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,20,0,0">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                            <TextBlock Text="{DynamicResource PhysicalInput}" Foreground="{DynamicResource TextSecondaryColor}" FontSize="10" FontWeight="Normal" />
                            <TextBlock Grid.Column="1" Text="{Binding SmoothedRightTriggerPercent, StringFormat={}{0:0}%}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                        </Grid>
                        <ProgressBar Grid.Row="1" Minimum="0" Maximum="100" Value="{Binding SmoothedRightTriggerPercent}" Height="6" CornerRadius="3" Foreground="{DynamicResource AccentColor}" Background="{DynamicResource ToggleContainerColor}" />

                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,16,0,6">
                            <TextBlock Text="{DynamicResource CurveOutput}" Foreground="{DynamicResource TextSecondaryColor}" FontSize="10" FontWeight="Normal" />
                            <TextBlock Grid.Column="1" Text="{Binding SmoothedRightTriggerOutputPercent, StringFormat={}{0:0}%}" Foreground="{DynamicResource RgbGreenColor}" FontSize="12" FontWeight="SemiBold" />
                        </Grid>
                        <ProgressBar Grid.Row="3" Minimum="0" Maximum="100" Value="{Binding SmoothedRightTriggerOutputPercent}" Height="6" CornerRadius="3" Foreground="{DynamicResource RgbGreenColor}" Background="{DynamicResource ToggleContainerColor}" />
                    </Grid>

                    <Grid Grid.Row="2" ColumnDefinitions="*,*" Margin="0,20,0,0">
                        <Border Background="{DynamicResource AltPanelBackgroundColor}" CornerRadius="8" Padding="10">
                            <StackPanel Spacing="3">
                                <TextBlock Text="RAW" Foreground="{DynamicResource TextMutedColor}" FontSize="8" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding RightTrigger}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock Text="/ 1023" Foreground="{DynamicResource TextMutedColor}" FontSize="8" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{DynamicResource AltPanelBackgroundColor}" CornerRadius="8" Padding="10" Margin="8,0,0,0">
                            <StackPanel Spacing="3">
                                <TextBlock Text="OUT" Foreground="{DynamicResource TextMutedColor}" FontSize="8" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding RightTriggerOutputByte}" Foreground="{DynamicResource RgbGreenColor}" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock Text="/ 255" Foreground="{DynamicResource TextMutedColor}" FontSize="8" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</UserControl>
