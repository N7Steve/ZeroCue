<!-- JOYSTICK DOTS -->
<Ellipse Width="100" Height="100" Fill="{DynamicResource AccentColor}" Opacity="{Binding LeftStickOpacity}" IsHitTestVisible="False" Canvas.Left="{Binding LeftStickKnobX}" Canvas.Top="{Binding LeftStickKnobY}">
    <Ellipse.RenderTransform><TranslateTransform X="-234" Y="-337" /></Ellipse.RenderTransform>
    <Ellipse.Transitions><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="LinearEasing" /></Transitions></Ellipse.Transitions>
</Ellipse>
<Ellipse Width="100" Height="100" Fill="{DynamicResource AccentColor}" Opacity="{Binding RightStickOpacity}" IsHitTestVisible="False" Canvas.Left="{Binding RightStickKnobX}" Canvas.Top="{Binding RightStickKnobY}">
    <Ellipse.RenderTransform><TranslateTransform X="-78" Y="35" /></Ellipse.RenderTransform>
    <Ellipse.Transitions><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="LinearEasing" /></Transitions></Ellipse.Transitions>
</Ellipse>

