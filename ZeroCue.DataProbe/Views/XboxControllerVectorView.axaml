<!-- THUMBSTICK CLICKS (L3 / R3) -->
<Button Classes="pathRemapBtn" Command="{Binding BeginRemapCommand}" CommandParameter="LeftThumb" Classes.active="{Binding ButtonL3}" Canvas.Left="540.9075" Canvas.Top="849.855">
    <Rectangle Classes="btnPath" Width="160" Height="160" RadiusX="80" RadiusY="80" />
</Button>
<Button Classes="pathRemapBtn" Command="{Binding BeginRemapCommand}" CommandParameter="RightThumb" Classes.active="{Binding ButtonR3}" Canvas.Left="1475.855" Canvas.Top="1222.02">
    <Rectangle Classes="btnPath" Width="160" Height="160" RadiusX="80" RadiusY="80" />
</Button>

            </Canvas>
        </Panel>
    </Viewbox>

    <StackPanel Grid.Row="0"
                IsVisible="{Binding IsTriggerOutputDialMounted}"
                Opacity="{Binding TriggerOutputDialOpacity}"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,26"
                Spacing="4">
        <StackPanel.Transitions>
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.18"/>
            </Transitions>
        </StackPanel.Transitions>
        <Grid Width="84" Height="84" HorizontalAlignment="Center">
            <Ellipse Fill="{DynamicResource HeaderBackgroundColor}"
                     Stroke="{DynamicResource BorderHighlightColor}"
                     StrokeThickness="5"/>
            <Ellipse Margin="8"
                     Fill="Transparent"
                     Stroke="{DynamicResource AccentSemiTransparentColor}"
                     StrokeThickness="3"/>
            <TextBlock Text="{Binding TriggerOutputPercentText}"
                       Foreground="{DynamicResource TextHeaderColor}"
                       FontSize="20"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Grid>
        <TextBlock Text="{DynamicResource TriggerOutputScrollHint}"
                   Foreground="{DynamicResource TextSecondaryColor}"
                   FontSize="12"
                   HorizontalAlignment="Center"/>
    </StackPanel>
</Grid>

</UserControl>
